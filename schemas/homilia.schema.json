{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Homilia",
  "type": "object",
  "required": ["slug", "titulo", "data", "celebrante", "resumo"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "titulo": { "type": "string", "minLength": 5, "maxLength": 160 },
    "data": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "celebrante": { "type": "string" },
    "ocasiao": { "type": "string", "description": "Ex.: 'Domingo de Pascoa', '4o Domingo do Tempo Comum'" },
    "leitura_evangelho": {
      "type": "object",
      "properties": {
        "referencia": { "type": "string", "description": "Ex.: 'Jo 20,1-9'" },
        "texto": { "type": "string" }
      }
    },
    "resumo": { "type": "string", "minLength": 30, "maxLength": 320 },
    "transcricao": { "type": "string" },
    "audio_url": { "type": "string" },
    "video_url": { "type": "string", "description": "URL YouTube/Vimeo" },
    "imagem_capa": {
      "type": ["string", "object"],
      "properties": {
        "url": { "type": "string" },
        "alt": { "type": "string" }
      }
    },
    "publicado": { "type": "boolean" }
  }
}
