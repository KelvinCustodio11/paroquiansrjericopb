{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Paroco",
  "type": "object",
  "required": ["nome", "biografia"],
  "properties": {
    "nome": { "type": "string" },
    "saudacao": { "type": "string", "description": "Ex.: 'Padre', 'Pe.', 'Mons.'" },
    "data_ordenacao": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "data_inicio_paroquia": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "biografia": { "type": "string", "minLength": 50 },
    "foto": { "type": "string" },
    "contato": {
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "telefone": { "type": "string" }
      }
    },
    "redes_sociais": {
      "type": "object",
      "properties": {
        "facebook": { "type": "string" },
        "instagram": { "type": "string" }
      }
    }
  }
}
