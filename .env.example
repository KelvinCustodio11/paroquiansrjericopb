# Variáveis de ambiente — Paróquia NSR Jericó/PB
# Copie para `.env` e preencha em produção (não comitar `.env`).
# No Plesk/Hostinger, defina essas variáveis no painel "Variáveis de Ambiente".

# E-mail destinatário das mensagens do formulário de contato
EMAIL_TO=contato@pascomjerico.com.br

# Remetente (deve ser do próprio domínio para passar SPF/DKIM)
EMAIL_FROM=nao-responda@pascomjerico.com.br
EMAIL_FROM_NAME="Site Paróquia NSR Jericó/PB"

# (Opcional) reCAPTCHA v3
# RECAPTCHA_SECRET=
# RECAPTCHA_MIN_SCORE=0.5
