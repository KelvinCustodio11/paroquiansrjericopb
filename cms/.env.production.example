APP_NAME="Paróquia NSR Jericó"
APP_ENV=production
APP_KEY=          # gerar com: php artisan key:generate
APP_DEBUG=false
APP_URL=https://admin.pascomjerico.com.br

# Caminho absoluto no servidor onde o site estático fica.
# Estrutura real no Plesk (pedisys como revendedor):
#   CMS:  /var/www/vhosts/pedisys.com.br/cms/
#   Site: /var/www/vhosts/pedisys.com.br/pascomjerico.com.br/
# STATIC_DISK_ROOT deve apontar para a raiz do site estático (disco site_static).
# SITE_ROOT deve apontar para a mesma pasta (usado pelo content:build-php).
STATIC_DISK_ROOT=/var/www/vhosts/pedisys.com.br/pascomjerico.com.br
APP_STATIC_URL=https://pascomjerico.com.br

# Banco de dados (SQLite)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/vhosts/pedisys.com.br/cms/database/database.sqlite

# Filas — usa banco para não precisar de Redis
QUEUE_CONNECTION=database

# E-mail (para notificações futuras)
MAIL_MAILER=smtp
MAIL_HOST=smtp.pascomjerico.com.br
MAIL_PORT=587
MAIL_USERNAME=noreply@pascomjerico.com.br
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@pascomjerico.com.br
MAIL_FROM_NAME="Paróquia NSR Jericó"

# Logs
LOG_CHANNEL=daily
LOG_LEVEL=error

# Cache
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Caminho absoluto da raiz do site estático (deve ser igual ao STATIC_DISK_ROOT)
SITE_ROOT=/var/www/vhosts/pedisys.com.br/pascomjerico.com.br

# CORS: origens permitidas para a API de visualizações (separadas por vírgula)
CORS_ALLOWED_ORIGINS=https://pascomjerico.com.br,https://www.pascomjerico.com.br
