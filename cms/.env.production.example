APP_NAME="Paróquia NSR Jericó"
APP_ENV=production
APP_KEY=          # gerar com: php artisan key:generate
APP_DEBUG=false
APP_URL=https://admin.pascomjerico.com.br

# Caminho absoluto no servidor onde o site estático fica (httpdocs/)
# O CMS grava os HTMLs diretamente aqui ao clicar "Publicar"
STATIC_DISK_ROOT=/var/www/vhosts/pascomjerico.com.br/httpdocs
APP_STATIC_URL=https://pascomjerico.com.br

# Banco de dados (SQLite recomendado para começar)
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/vhosts/pascomjerico.com.br/cms/database/database.sqlite

# Filas — usa banco para não precisar de Redis
QUEUE_CONNECTION=database

# E-mail (para notificações futuras)
MAIL_MAILER=smtp
MAIL_HOST=smtp.pascomjerico.com.br
MAIL_PORT=587
MAIL_USERNAME=noreply@pascomjerico.com.br
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@pascomjerico.com.br
MAIL_FROM_NAME="Paróquia NSR Jericó"

# Logs
LOG_CHANNEL=daily
LOG_LEVEL=error

# Cache
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
